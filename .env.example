# ---------------------------------------------------------------------------
# Face-Verify-Chain — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file to version control.
#
#   cp .env.example .env
#   # then edit .env with your keys
# ---------------------------------------------------------------------------


# ============================================================
# REQUIRED — Reverse Image Search
# ============================================================

# SerpAPI key — https://serpapi.com (free tier: 100 searches/month)
# Used to submit reverse image searches via Google.
SERPAPI_KEY=your_serpapi_key_here


# imgbb API key — https://api.imgbb.com (free, no credit card)
# Used to temporarily host the cropped face image at a public URL
# so that SerpAPI / Google can fetch it for reverse search.
# Images are automatically deleted after 10 minutes.
IMGBB_KEY=your_imgbb_key_here


# ============================================================
# OPTIONAL — Future extensions
# ============================================================

# Google Cloud Vision API key (alternative to SerpAPI)
# GOOGLE_VISION_KEY=your_google_vision_key_here

# PimEyes API key (paid, highly accurate facial reverse search)
# PIMEYES_KEY=your_pimeyes_key_here

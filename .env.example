# ---------------------------------------------------------------------------
# Face-Verify-Chain — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file to version control.
#
#   cp .env.example .env
#   # then edit .env with your keys
# ---------------------------------------------------------------------------


# ============================================================
# REQUIRED — Reverse Image Search (Step 2)
# ============================================================

# SerpAPI key — https://serpapi.com (free tier: 100 searches/month)
# Used to submit reverse image searches via Google.
SERPAPI_KEY=your_serpapi_key_here

# imgbb API key — https://api.imgbb.com (free, no credit card)
# Used to temporarily host the cropped face image at a public URL
# so that SerpAPI / Google can fetch it for reverse search.
# Images are automatically deleted after 10 minutes.
IMGBB_KEY=your_imgbb_key_here


# ============================================================
# REQUIRED — Blockchain Anchoring (Step 5 + 6)
# ============================================================

# Which chain to use:
#   ganache  — local Ganache (default, great for testing, no real money)
#   custom   — any EVM-compatible RPC, e.g. Polygon Amoy testnet or mainnet
CHAIN_BACKEND=ganache

# Anchoring strategy:
#   calldata  — embeds hash as tx calldata to a burn address (no contract needed)
#   contract  — calls FaceVerifyChain.anchor(bytes32) (requires CONTRACT_ADDRESS)
ANCHOR_MODE=calldata

# RPC endpoint — only needed for the custom backend
# Free options for Polygon Amoy (testnet, chain_id 80002):
#   Public RPC : https://polygon-amoy-bor-rpc.publicnode.com
#   Alchemy    : https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
#   Infura     : https://polygon-amoy.infura.io/v3/YOUR_KEY
CHAIN_RPC_URL=http://127.0.0.1:8545

# Private key of the signing account (0x-prefixed)
# For Ganache: leave empty — the first unlocked account is used automatically
# For custom (e.g. Amoy): must be set — use a throwaway testnet wallet only,
# never a wallet holding real funds. Get free test POL at
# https://faucet.polygon.technology (select "Amoy").
CHAIN_PRIVATE_KEY=

# Deployed contract address — only needed for ANCHOR_MODE=contract
# Run:  python contracts/deploy.py  to deploy and auto-fill this value
CONTRACT_ADDRESS=


# ============================================================
# OPTIONAL — Future extensions
# ============================================================

# Google Cloud Vision API key (alternative to SerpAPI)
# GOOGLE_VISION_KEY=your_google_vision_key_here

# PimEyes API key (paid, highly accurate facial reverse search)
# PIMEYES_KEY=your_pimeyes_key_here
